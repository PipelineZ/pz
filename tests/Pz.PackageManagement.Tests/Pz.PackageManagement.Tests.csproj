<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.61" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Pz.PackageManagement\Pz.PackageManagement.csproj" />
    <ProjectReference Include="..\..\src\Pz.Core\Pz.Core.csproj" />
    <ProjectReference Include="..\Pz.TestSupport\Pz.TestSupport.csproj" />
    <!-- HandshakeTests spawns this fixture as a child process rather than calling into it, so the
         reference exists only to make `dotnet build`/`dotnet test` build it first, never to link
         its assembly (which would pull the fixture's own Program/console-host types in). -->
    <ProjectReference Include="..\fixtures\PcpFakeConnector\PcpFakeConnector.csproj" ReferenceOutputAssembly="false" />
    <!-- HandshakeTests computes the expected handshake capability set from the real connector's
         Capabilities flags rather than hardcoding the number, so the assertion tracks LocalFiles
         instead of silently drifting from it. -->
    <ProjectReference Include="..\..\connectors\Pz.Connector.LocalFiles\Pz.Connector.LocalFiles.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bash fixtures for ConnectorProcessTests; the executable bit does not survive the copy, so the
         test fixture chmods them in setup rather than relying on git/MSBuild to preserve it. -->
    <Content Include="ProcessHosting\fake-exes\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Pz.Engine\Pz.Engine.csproj" />
    <ProjectReference Include="..\Pz.Mcp\Pz.Mcp.csproj" />
    <ProjectReference Include="..\Pz.PackageManagement\Pz.PackageManagement.csproj" />
    <!-- StateBackendFactory composes the SQL Server state backend directly, not through the connector
         ABI: management verbs (`pz state show`) must work without package restore or ALC loading. -->
    <ProjectReference Include="..\Pz.State.Http\Pz.State.Http.csproj" />
    <ProjectReference Include="..\Pz.State.SqlServer\Pz.State.SqlServer.csproj" />
    <ProjectReference Include="..\..\connectors\Pz.Connector.LocalFiles\Pz.Connector.LocalFiles.csproj" />
    <ProjectReference Include="..\..\connectors\Pz.Connector.MySql\Pz.Connector.MySql.csproj" />
    <ProjectReference Include="..\..\connectors\Pz.Connector.S3\Pz.Connector.S3.csproj" />
    <ProjectReference Include="..\..\connectors\Pz.Connector.Postgres\Pz.Connector.Postgres.csproj" />
    <ProjectReference Include="..\..\connectors\Pz.Connector.Sqlite\Pz.Connector.Sqlite.csproj" />
    <ProjectReference Include="..\..\connectors\Pz.Connector.SqlServer\Pz.Connector.SqlServer.csproj" />
    <ProjectReference Include="..\..\connectors\Pz.Connector.AzureBlob\Pz.Connector.AzureBlob.csproj" />
    <ProjectReference Include="..\..\connectors\Pz.Connector.Gcs\Pz.Connector.Gcs.csproj" />
    <ProjectReference Include="..\..\connectors\Pz.Connector.Http\Pz.Connector.Http.csproj" />
    <ProjectReference Include="..\..\connectors\Pz.Connector.Sftp\Pz.Connector.Sftp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pz.Cli.Tests" />
    <!-- Pz.Mcp.Tests exercises the real Pz.Cli.ConnectorRegistryFactory (internal — same seam Pz.Cli's
         own McpCommand uses) end to end rather than a fake, so the verify tools are covered against
         the registry the shipping CLI actually builds. -->
    <InternalsVisibleTo Include="Pz.Mcp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- `pz init`'s ONLY template source, and simultaneously the browsable, in-place-runnable
         projects the test suite compiles. One copy exists: a second would drift, which is exactly
         what happened to the hand-maintained copy this replaces.
         Linked in from outside the project directory so the templates can live at the repo root
         where a reader finds them; an installed tool still carries them with no source tree on disk.
         The Exclude is load-bearing: these directories are runnable in place, so anyone who runs one
         leaves .pz/ and out/ behind, and without it those artifacts would ship inside the tool.
         LogicalName is forced to forward slashes on every OS (RecursiveDir/Filename/Extension can
         come back with backslashes from a Windows-hosted build) so InitCommand's "Templates/" prefix
         match and relative-path reconstruction are platform-independent. -->
    <EmbeddedResource Include="..\..\templates\**\*"
                      Exclude="..\..\templates\**\.pz\**;..\..\templates\**\out\**">
      <LogicalName>Templates/$([System.String]::new('%(RecursiveDir)%(Filename)%(Extension)').Replace('\', '/'))</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry" Version="1.16.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.16.0" />
    <PackageReference Include="Spectre.Console" Version="0.57.1" />
    <PackageReference Include="System.CommandLine" Version="2.0.9" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The packable tool: this is the project that ships as the `pz` command. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>pz</ToolCommandName>
    <!-- The published id is the command people type, not the project name, so the install line is
         `dotnet tool install -g pz`: an id anyone has to be told ("it's Pz.Cli, with a dot") is
         friction on the one command that has to work before any other. The project, assembly, and
         namespace stay Pz.Cli; only the id on nuget.org differs, and this is the single place the
         two names diverge. Two consequences to keep in mind:
         (1) the nuget.org trusted publishing policy scopes ids by glob, and neither a bare `pz` nor
             the RID sub-packages (`pz.linux-x64`, ...) match "Pz.*". A policy covering `pz` AND
             `pz.*` is a manual prerequisite; without it release.yml fails authentication pushing
             these packages alone. Its prerequisites block says so.
         (2) `Pz.Cli` published 0.1.0 through 0.2.0 under the old id and is deprecated on nuget.org
             pointing here. NuGet has no redirect, so `dotnet tool update -g Pz.Cli` still resolves
             the old id, and a global install of the old package must be uninstalled before `pz`
             installs, because both packages claim the same `pz` shim name. -->
    <PackageId>pz</PackageId>
    <!-- Leads with the project name: nuget.org's search matches the description, and "PipelineZ"
         appeared nowhere in the old text, so the flagship package was the hardest of the four to find
         by the name people actually know it by. Naming the bundled connectors is not padding either,
         it is what someone searching "duckdb postgres etl" needs to see to recognize a match. -->
    <Description>PipelineZ (pz): a lightweight, developer-first batch data pipeline engine for SQL-based ETL/ELT, powered by DuckDB, that can run anywhere without requiring a data platform. Describe your pipeline in plain SQL files. Bundles connectors for local files, S3, Azure Blob, Google Cloud Storage, Postgres, SQL Server, MySQL, SQLite and HTTP.</Description>
    <!-- Hybrid Native AOT tool packaging (.NET 10 RID-specific tools). `dotnet pack` with no -r
         produces the `pz` POINTER package that lists the RID sub-packages below; `dotnet pack -r
         <rid>` produces that RID's self-contained Native AOT package and must run on a machine whose
         OS matches the RID (AOT cannot cross-compile between OSes — release.yml runs one pack job
         per OS); `dotnet pack -r any -p:PublishAot=false` produces the framework-dependent CoreCLR
         fallback that serves every platform not in this list. Install is unchanged for users:
         `dotnet tool install -g pz` picks the right sub-package, and RID sub-packages must all be
         pushed BEFORE the pointer or installs fail in the gap. RollForward is intentionally omitted:
         the `any` fallback targets net10.0 exactly (Global Constraints: TFM net10.0 everywhere), so
         there is no older major runtime to roll forward from. -->
    <ToolPackageRuntimeIdentifiers>linux-x64;linux-arm64;win-x64;osx-arm64;any</ToolPackageRuntimeIdentifiers>
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <!-- Native AOT (RID-specific publishes/packs only; the `any` tool package stays CoreCLR).
       First-party code is held to zero trim/AOT warnings by the compile-time analyzers under
       TreatWarningsAsErrors; what is demoted here is only the ILC-stage per-assembly rollup
       (IL2104/IL3053) for third-party libraries whose internals warn and cannot be fixed from this
       repository. The reflection-risky ones are rooted so trimming cannot remove members they reach
       dynamically; scripts/verify-aot.sh is the runtime proof for all of them. -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <ILLinkTreatWarningsAsErrors>false</ILLinkTreatWarningsAsErrors>
    <!-- The per-assembly rollup codes only; every other IL warning still errors, so a first-party
         regression cannot hide behind this. MSBuildWarningsNotAsErrors is what reaches warnings the
         ILC Exec task raises through the engine rather than the compiler. IL3002 joins the list for
         one third-party site: Google.Apis' VersionHeaderBuilder probes Assembly.CodeBase/GetFiles
         to build its version header and already catches the single-file throw at runtime
         (degrading to a null version). First-party code cannot hide here either, because the
         single-file analyzer errors at compile time before ILC ever runs. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2104;IL3053;IL3002</WarningsNotAsErrors>
    <MSBuildWarningsNotAsErrors>$(MSBuildWarningsNotAsErrors);IL2104;IL3053;IL3002</MSBuildWarningsNotAsErrors>
  </PropertyGroup>
  <ItemGroup Condition="'$(PublishAot)' == 'true'">
    <!-- NuGet's JSON layer is Newtonsoft reflection over its own DTOs; `pz restore` depends on it. -->
    <TrimmerRootAssembly Include="Newtonsoft.Json" />
    <TrimmerRootAssembly Include="NuGet.Protocol" />
    <TrimmerRootAssembly Include="NuGet.Packaging" />
    <!-- SqlClient reaches config/crypto members reflectively; the state backend and connector need it. -->
    <TrimmerRootAssembly Include="Microsoft.Data.SqlClient" />
    <TrimmerRootAssembly Include="System.Configuration.ConfigurationManager" />
    <!-- The Google stack serializes its request/response DTOs via Newtonsoft reflection; the gcs
         connector's universal write tier needs those members to survive trimming. -->
    <TrimmerRootAssembly Include="Google.Apis" />
    <TrimmerRootAssembly Include="Google.Apis.Core" />
    <TrimmerRootAssembly Include="Google.Apis.Auth" />
    <TrimmerRootAssembly Include="Google.Apis.Storage.v1" />
    <TrimmerRootAssembly Include="Google.Cloud.Storage.V1" />
  </ItemGroup>

</Project>

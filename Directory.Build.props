<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- MinVer drives every packable project's version from git tags (MinVerTagPrefix
       "v" -> tags like v0.1.0). Pre-tag builds produce a 0.0.0-alpha.0.<height> height-based prerelease;
       the first real release tag is v0.1.0. PrivateAssets=All keeps MinVer itself out of consumers'
       dependency graphs. -->
  <ItemGroup>
    <PackageReference Include="MinVer" Version="6.*" PrivateAssets="All" />
  </ItemGroup>

  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>

  <!-- Shared NuGet package metadata for every packable project. Exactly five ids publish today, and
       each has a real consumer: pz (the product; the Pz.Cli project publishes under that id, see its
       PackageId override), Pz.Connectors.Abstractions (the ABI a connector
       author compiles against), Pz.Connectors.Toolkit (shared codecs and format helpers),
       Pz.Connectors.TestKit (the acceptance suite a connector runs against), and
       Pz.Connectors.Sdk (the out-of-process connector SDK).
       Packability is opt-OUT: every other project sets <IsPackable>false</IsPackable> explicitly in
       its own .csproj, which flips this Condition off for them. That includes all eight builtin
       connectors, which ship inside the `pz` tool package; publishing them separately produced
       packages nobody could install and use, because the host that drives a connector
       (Pz.PackageManagement) is itself unpublished. A NEW project is therefore packable the moment it
       exists, so anything genuinely meant to publish needs no ceremony, and anything not meant to
       publish must say so. CONTRIBUTING.md "Release process" holds the authoritative id list.
       Icon is the favicon mark (assets/brand/pz-favicon.svg, rasterized to pz-icon.png): square,
       opaque dark background, so it reads correctly in both the gallery's light and dark themes
       without relying on a `prefers-color-scheme` swap that a static PNG can't carry. -->
  <PropertyGroup Condition="'$(IsPackable)' != 'false'">
    <Authors>PipelineZ contributors</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/pipelinez/pz</RepositoryUrl>
    <!-- RepositoryUrl is the source link; PackageProjectUrl is what the gallery renders as the
         package's website, so it points at the documentation site rather than the repository. -->
    <PackageProjectUrl>https://pipelinez.dev</PackageProjectUrl>
    <!-- Every package shipped with an EMPTY tag list through v0.1.1, which is the main lever
         nuget.org search offers besides id and description. "pipelinez" leads because that is the
         name people know the project by while every id starts with the abbreviation "Pz".
         Deliberately NOT tagged "pipelinez-connector": that is the ratified discovery tag for
         third-party connector packages, and applying it to first-party tooling would pollute the
         one query an author uses to find real connectors. Kept short on purpose. Tag stuffing is
         penalized by relevance ranking and reads as spam on the gallery page. -->
    <PackageTags>pipelinez;pz;etl;elt;duckdb;data-pipeline;data-engineering;sql;arrow</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)assets/brand/pz-icon.png" Pack="true" PackagePath="icon.png" Visible="false" />
  </ItemGroup>
</Project>

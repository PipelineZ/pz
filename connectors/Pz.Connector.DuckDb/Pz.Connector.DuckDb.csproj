<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>DuckDB database-file connector (native-path-only: DuckDB's own ATTACH is the entire data plane) for PipelineZ (pz).</Description>
    <!-- Builtin connector, ships inside the Pz.Cli tool package: see the note in
         Pz.Connector.LocalFiles.csproj for why a separate nupkg would be unconsumable. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Pz.Connectors.Abstractions\Pz.Connectors.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Pz.Connectors.Toolkit\Pz.Connectors.Toolkit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pz.Connector.DuckDb.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same nupkg-root manifest embedding as the other builtin connectors (see the note in
         Pz.Connector.Postgres.csproj for why Pack+PackagePath instead of CopyToOutputDirectory). -->
    <None Include="pz.connector.json" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared connector mechanics compiled from one source file; connectors never reference each other. -->
    <Compile Include="..\..\src\Shared\Sql\DuckDbSqlText.cs" Link="Shared\Sql\DuckDbSqlText.cs" />
  </ItemGroup>

</Project>

<Project>
  <!-- Defaults for a pz connector project. Every value here may be overridden in the project file,
       which MSBuild evaluates after this import. Only defaults and unconditional settings belong
       here: anything derived from a value the project may set has to wait for the .targets. -->
  <PropertyGroup>
    <PzPackaging Condition="'$(PzPackaging)' == ''">aot</PzPackaging>
    <PzRuntimeIdentifiers Condition="'$(PzRuntimeIdentifiers)' == ''">linux-x64;linux-arm64;osx-arm64;win-x64</PzRuntimeIdentifiers>
    <PzNativeStaging Condition="'$(PzNativeStaging)' == ''">$(MSBuildProjectDirectory)/bin/pz-native/</PzNativeStaging>
    <PzNativeStaging>$([MSBuild]::EnsureTrailingSlash('$(PzNativeStaging)'))</PzNativeStaging>

    <!-- Set to true when the connector resolves relative paths in its own config (a root/path
         option): pz then passes the project directory as the `base_dir` connection option, so those
         paths resolve against the project rather than the process working directory. Off by default:
         a manifest that says nothing about it must be identical to one written before this existed. -->
    <PzProjectDirectoryAnchor Condition="'$(PzProjectDirectoryAnchor)' == ''">false</PzProjectDirectoryAnchor>

    <!-- The host only ever spawns the binary: a framework-dependent dll in lib/ and a dependency on
         this SDK would only make `pz restore` download things the connector never loads. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <!-- Self-contained needs a RID; a RID-less build (the usual dev loop) stays framework-dependent. -->
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
  </PropertyGroup>

  <!-- What each PzPackaging value means (PublishAot, PublishSingleFile, ...) is decided in the
       .targets, not here: this file is imported before the project body, so a <PzPackaging> the
       project sets would not be visible to a condition evaluated at this point. -->
</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <!-- Pinned above Testcontainers' unbounded 2025.1.0 floor: that version has a known high-severity
         SCP path-traversal advisory (GHSA-q939-rpr3-3284), fixed in 2026.0.0. NuGet audit (NU1903,
         WarningsAsErrors) fails restore otherwise. Test-only transitive dep of Testcontainers.MsSql. -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="Testcontainers.MsSql" Version="4.13.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.61" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Pz.State.SqlServer\Pz.State.SqlServer.csproj" />
    <ProjectReference Include="..\Pz.TestSupport\Pz.TestSupport.csproj" />
    <!-- EndToEndRunTests drives a real `pz run` (RunCommand, connectors, DAG compile/execute) against
         the SqlServerFixture container, proving a real run uses SQL Server end to end, which needs the
         full CLI stack, not just Pz.State.SqlServer's own stores in isolation. Test-only: this does not
         violate the strictly-downward layering rule (Pz.State.SqlServer itself still may not reference
         Pz.Cli). -->
    <ProjectReference Include="..\..\src\Pz.Cli\Pz.Cli.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Internal assembly: ships inside the Pz.Cli tool package rather than as its own NuGet. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pz.Connectors.Abstractions\Pz.Connectors.Abstractions.csproj" />
    <!-- Protocol references only Google.Protobuf/Grpc.Net.Client, not Pz.Core, so this stays
         within the "PackageManagement must not depend on Pz.Core" constraint (see ConnectorHost.cs). -->
    <ProjectReference Include="..\Pz.Connectors.Protocol\Pz.Connectors.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pz.PackageManagement.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NuGet.Protocol" Version="7.6.0" />
    <!-- PcpClient opens the control-plane GrpcChannel directly; flows transitively from
         Pz.Connectors.Protocol's ProjectReference too, but pinned explicitly here since this
         assembly calls into it, not just references generated types. -->
    <PackageReference Include="Grpc.Net.Client" Version="2.83.0" />
    <!-- DataPlane speaks Arrow IPC directly over the raw data-plane socket; flows transitively from
         Pz.Connectors.Abstractions's ProjectReference too, but pinned explicitly here for the same
         reason as Grpc.Net.Client above. -->
    <PackageReference Include="Apache.Arrow" Version="23.0.0" />
  </ItemGroup>

</Project>

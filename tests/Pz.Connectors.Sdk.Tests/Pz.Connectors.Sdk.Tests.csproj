<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <!-- The loopback OTLP/HTTP receiver is shared with Pz.Cli.Tests (one source, linked), parsing bodies with the
       vendored OTLP protos Pz.PackageManagement.Tests carries (messages only). -->
  <ItemGroup>
    <Compile Include="..\Pz.Cli.Tests\Otel\OtlpHttpReceiver.cs" Link="Otel\OtlpHttpReceiver.cs" />
    <PackageReference Include="Grpc.Tools" Version="2.84.0" PrivateAssets="All" />
    <Protobuf Include="..\Pz.PackageManagement.Tests\Otlp\proto\**\*.proto" ProtoRoot="..\Pz.PackageManagement.Tests\Otlp\proto" GrpcServices="None" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Pz.Connectors.Sdk\Pz.Connectors.Sdk.csproj" />
    <ProjectReference Include="..\..\src\Pz.Connectors.Abstractions\Pz.Connectors.Abstractions.csproj" />
  </ItemGroup>

</Project>

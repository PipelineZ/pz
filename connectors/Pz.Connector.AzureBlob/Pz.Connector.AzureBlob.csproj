<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Azure Blob Storage / ADLS Gen2 source and sink connector (DuckDB azure extension native tier + Azure SDK universal tier) for PipelineZ (pz).</Description>
    <!-- Builtin connector, ships inside the Pz.Cli tool package: see the note in
         Pz.Connector.LocalFiles.csproj for why a separate nupkg would be unconsumable. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Pz.Connectors.Abstractions\Pz.Connectors.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Pz.Connectors.Toolkit\Pz.Connectors.Toolkit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Storage.Blobs" Version="12.24.0" />
    <PackageReference Include="Azure.Storage.Files.DataLake" Version="12.22.0" />
    <PackageReference Include="Azure.Identity" Version="1.14.0" />
    <PackageReference Include="Parquet.Net" Version="6.0.3" />
    <PackageReference Include="Sylvan.Data.Csv" Version="1.4.4" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pz.Connector.AzureBlob.Tests" />
    <InternalsVisibleTo Include="Pz.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same packaging note as the other builtins: Pack+PackagePath only, no
         CopyToOutputDirectory (all builtin connectors are bundled into the pz tool
         package; output-relative copies would collide, NETSDK1152). -->
    <None Include="pz.connector.json" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>

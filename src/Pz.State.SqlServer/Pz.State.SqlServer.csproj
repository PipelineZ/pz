<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The state backend is a directly-referenced assembly, not a connector-ABI
         package: management verbs (`pz state show`, `pz cdc status`)
         must work without package restore or ALC loading. Ships inside the Pz.Cli tool package. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.1" />
    <!-- Microsoft.Data.SqlClient 6.1.1 (9.0.4) pulls in System.Security.Cryptography.Pkcs with CVE-2026-84008 and CVE-2026-70162
         (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7); pinned to the patched version until it ships one. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pz.Core\Pz.Core.csproj" />
    <ProjectReference Include="..\Pz.Engine\Pz.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- src/Shared/MsTransient.cs compiles into this assembly and into Pz.Connector.SqlServer's; the two
         assemblies may not reference each other (connector-to-state and state-to-connector are both
         forbidden), so the classifier is linked into each. -->
    <Compile Include="..\Shared\MsTransient.cs" Link="Shared\MsTransient.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The event-buffer overflow test needs a deterministic, non-timing-based gate on the background
         drain task, mirroring RunEventBus.PendingCountForTests's InternalsVisibleTo seam. -->
    <InternalsVisibleTo Include="Pz.State.SqlServer.Tests" />
  </ItemGroup>

</Project>

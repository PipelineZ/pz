<Project>
  <!-- Derived from PzPackaging HERE, after the project body, so a <PzPackaging> set in the project
       file wins over the props default the same way a -p: global property does. This import still
       precedes the .NET SDK's own publish, ILCompiler, ILLink and analyzer targets, which is where
       PublishAot, PublishSingleFile and IsAotCompatible are read. The one thing set this late cannot
       drive is the SDK's implicit-RID inference from PublishAot on a RID-less publish, which the
       packaging flow never relies on: staging only happens under `dotnet publish -r <rid>`. -->
  <PropertyGroup Condition="'$(PzPackaging)' == 'aot'">
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PzPackaging)' == 'self-contained'">
    <PublishAot>false</PublishAot>
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Native libraries stay beside the executable and ship as files: self-extraction on every
         spawn is a per-run cost and a temp-directory footprint for nothing. -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The ratified discovery tag for connector packages, appended once. Two conditions rather than
         one: a consumer who sets no PackageTags at all must not get a leading ';' (NuGet space-
         separates the nuspec tags, so ";pipelinez-connector" degrades to a leading space, i.e. two
         tokens where the intent is one). -->
    <PackageTags Condition="'$(PackageTags)' == ''">pipelinez-connector</PackageTags>
    <PackageTags Condition="'$(PackageTags)' != '' and !$(PackageTags.Contains('pipelinez-connector'))">$(PackageTags);pipelinez-connector</PackageTags>
  </PropertyGroup>

  <!-- Every path below is computed INSIDE the target that uses it, never in a file-level
       PropertyGroup. This file is imported from wherever a consumer's build puts package targets,
       which is before the .NET SDK infers RuntimeIdentifier and sets IntermediateOutputPath: an
       import-time $(RuntimeIdentifier) would be empty on any implicit-RID publish (PublishAot with
       no -r, a single-entry RuntimeIdentifiers) while the target's own condition, evaluated later,
       is true. Computing at execution time is what makes the file import-position independent.
       _PzStaging is also the trailing-slash-safe copy of PzNativeStaging, which may arrive as a
       global property (-p:) the props file never gets to normalize. -->

  <Target Name="PzValidatePackaging" BeforeTargets="BeforeBuild;GenerateNuspec">
    <Error Condition="'$(PzPackaging)' != 'aot' and '$(PzPackaging)' != 'self-contained'"
           Code="PZSDK004"
           Text="PzPackaging must be 'aot' or 'self-contained' (got '$(PzPackaging)')." />
  </Target>

  <!-- After `dotnet publish -r <rid>`: the publish output, minus symbols, becomes
       <PzNativeStaging>/<rid>/, which `dotnet pack` later ships as runtimes/<rid>/native/. Native
       dependencies sit beside the executable in the publish output and travel with it. -->
  <Target Name="PzStageNative" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' != ''">
    <PropertyGroup>
      <_PzStaging>$([MSBuild]::EnsureTrailingSlash('$(PzNativeStaging)'))</_PzStaging>
      <_PzStageDir>$(_PzStaging)$(RuntimeIdentifier)/</_PzStageDir>
    </PropertyGroup>
    <ItemGroup>
      <_PzPublished Include="$(PublishDir)**/*"
                    Exclude="$(PublishDir)**/*.pdb;$(PublishDir)**/*.dbg;$(PublishDir)**/*.dsym/**" />
    </ItemGroup>
    <RemoveDir Directories="$(_PzStageDir)" />
    <Copy SourceFiles="@(_PzPublished)"
          DestinationFiles="@(_PzPublished->'$(_PzStageDir)%(RecursiveDir)%(Filename)%(Extension)')" />
    <Message Importance="high" Text="pz: staged $(RuntimeIdentifier) connector binary in $(_PzStageDir)" />
  </Target>

  <Target Name="_PzFindStagedRids">
    <PropertyGroup>
      <_PzStaging>$([MSBuild]::EnsureTrailingSlash('$(PzNativeStaging)'))</_PzStaging>
    </PropertyGroup>
    <ItemGroup>
      <_PzStagedRidDir Include="$([System.IO.Directory]::GetDirectories('$(_PzStaging)'))"
                       Condition="Exists('$(_PzStaging)')" />
    </ItemGroup>
  </Target>

  <!-- The manifest is produced by RUNNING the connector for the packing machine's own RID, so the
       manifest and the handshake come from one object and cannot disagree. -->
  <Target Name="PzGenerateManifest" DependsOnTargets="_PzFindStagedRids">
    <PropertyGroup>
      <_PzStaging>$([MSBuild]::EnsureTrailingSlash('$(PzNativeStaging)'))</_PzStaging>
      <_PzManifestPath>$(IntermediateOutputPath)pz.connector.json</_PzManifestPath>
    </PropertyGroup>
    <Error Condition="'@(_PzStagedRidDir)' == ''"
           Code="PZSDK001"
           Text="pz: no staged connector binary under '$(_PzStaging)'. Run `dotnet publish -r &lt;rid&gt;` for at least one RID before `dotnet pack`." />
    <PropertyGroup>
      <_PzHostRid>$(NETCoreSdkRuntimeIdentifier)</_PzHostRid>
      <_PzHostExe>$(_PzStaging)$(_PzHostRid)/$(AssemblyName)</_PzHostExe>
      <_PzHostExe Condition="$(_PzHostRid.StartsWith('win'))">$(_PzHostExe).exe</_PzHostExe>
    </PropertyGroup>
    <Error Condition="!Exists('$(_PzHostExe)')"
           Code="PZSDK003"
           Text="pz: the packing machine's RID '$(_PzHostRid)' has no staged binary at '$(_PzHostExe)'. The manifest is produced by running the connector, so publish for this RID here before packing." />
    <ItemGroup>
      <_PzStagedRid Include="@(_PzStagedRidDir->'%(Filename)%(Extension)')" />
      <!-- Each rid=path pair is quoted as ONE argument: an AssemblyName containing a space would
           otherwise split across two argv entries and fail HostArguments' <rid>=<path> parse with a
           confusing error instead of a clean one. -->
      <_PzEntrypointArg Include="--entrypoint &quot;%(_PzStagedRid.Identity)=native/$(AssemblyName)&quot;"
                        Condition="!$([System.String]::Copy('%(_PzStagedRid.Identity)').StartsWith('win'))" />
      <_PzEntrypointArg Include="--entrypoint &quot;%(_PzStagedRid.Identity)=native/$(AssemblyName).exe&quot;"
                        Condition="$([System.String]::Copy('%(_PzStagedRid.Identity)').StartsWith('win'))" />
      <_PzWantedRid Include="$(PzRuntimeIdentifiers)" />
      <_PzMissingRid Include="@(_PzWantedRid)" Exclude="@(_PzStagedRid)" />
    </ItemGroup>
    <PropertyGroup>
      <_PzAnchorArg Condition="'$(PzProjectDirectoryAnchor)' == 'true'">--project-directory-anchor</_PzAnchorArg>
    </PropertyGroup>
    <Warning Condition="'@(_PzMissingRid)' != ''"
             Code="PZSDK002"
             Text="pz: no staged binary for @(_PzMissingRid, ', '); the package will not run there. Publish for those RIDs, or set PzRuntimeIdentifiers to the set you ship." />
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Exec Command="&quot;$(_PzHostExe)&quot; --pz-manifest --out &quot;$(_PzManifestPath)&quot; @(_PzEntrypointArg, ' ') $(_PzAnchorArg)" />
    <ItemGroup>
      <None Include="$(_PzManifestPath)" Pack="true" PackagePath="" />
    </ItemGroup>
  </Target>

  <!-- One target run per staged RID directory (target batching on Identity): its files pack flat
       under runtimes/<rid>/native/, which the pz host flattens into <package>/native/ for its RID. -->
  <Target Name="_PzCollectOneRid" DependsOnTargets="_PzFindStagedRids" Outputs="%(_PzStagedRidDir.Identity)">
    <PropertyGroup>
      <_PzRidDir>%(_PzStagedRidDir.FullPath)</_PzRidDir>
      <_PzRid>%(_PzStagedRidDir.Filename)%(_PzStagedRidDir.Extension)</_PzRid>
    </PropertyGroup>
    <ItemGroup>
      <None Include="$(_PzRidDir)/**/*" Pack="true" PackagePath="runtimes/$(_PzRid)/native/" />
    </ItemGroup>
  </Target>

  <Target Name="PzCollectNativeAssets" BeforeTargets="_GetPackageFiles" DependsOnTargets="PzGenerateManifest;_PzCollectOneRid" />
</Project>

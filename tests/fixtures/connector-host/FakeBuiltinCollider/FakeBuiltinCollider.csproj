<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>FakeBuiltinCollider</PackageId>
    <!-- This is a test-double NuGet fixture, not one of the repo's 6 real packable
         projects. Its version is test-authored data (consuming tests assert an exact "1.0.0"); MinVer
         (wired repo-wide via Directory.Build.props) would otherwise stomp it with a height-based
         version on every pack. -->
    <MinVerSkip>true</MinVerSkip>
    <!-- Its Pz.Connectors.Abstractions ProjectReference now floats on MinVer's real height-based
         prerelease version while this fixture stays pinned "stable" (1.0.0) — see FakeSourceConnector's
         identical NU5104 note. -->
    <NoWarn>$(NoWarn);NU5104</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../src/Pz.Connectors.Abstractions/Pz.Connectors.Abstractions.csproj" />
  </ItemGroup>
</Project>

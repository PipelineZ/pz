<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Shared connector mechanism library (codecs, SQL text, paging, auth, bindings, transient classification) for PipelineZ (pz) connectors. Not part of the connector ABI: it grows and changes independently of Pz.Connectors.Abstractions.</Description>
    <!-- CsvWriteCodec pins each Arrow column buffer once per batch and reads cells through raw
         pointers; going through Span/Memory per cell costs more than the formatting does. Same
         reason Pz.Connectors.Abstractions (pooled native buffers) and Pz.DuckDb (the C Data
         Interface) enable it. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pz.Connectors.Abstractions\Pz.Connectors.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pz.Connectors.Toolkit.Tests" />
  </ItemGroup>

</Project>

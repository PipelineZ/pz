<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <!-- Pinned above Testcontainers' unbounded 2025.1.0 floor: that version has a known high-severity
         SCP path-traversal advisory (GHSA-q939-rpr3-3284), fixed in 2026.0.0. NuGet audit (NU1903,
         WarningsAsErrors) fails restore otherwise. Test-only transitive dep of Testcontainers.PostgreSql. -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.13.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.61" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Pz.Cli\Pz.Cli.csproj" />
    <ProjectReference Include="..\..\src\Pz.DuckDb\Pz.DuckDb.csproj" />
    <ProjectReference Include="..\Pz.TestSupport\Pz.TestSupport.csproj" />
    <!-- Build-order only (ReferenceOutputAssembly=false): ProcessHostParityTests spawns the fixture's
         apphost off disk as a connector package's entrypoint, so it must exist before this suite runs;
         nothing here references its assembly. -->
    <ProjectReference Include="..\fixtures\PcpFakeConnector\PcpFakeConnector.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
